# Sentra MVP - Git Ignore File
# IMPORTANT: Never commit credentials, account IDs, or sensitive data

# ===================================
# AWS Credentials & Configuration
# ===================================
# NEVER commit these files
*.pem
*.key
credentials
credentials.*
.aws/
aws-credentials.*
config.ini

# Environment files with secrets
.env
.env.*
!.env.example
*.local

# Cognito user credentials (NEVER commit!)
scripts/.cognito-users.conf

# ===================================
# CDK Output & Build Artifacts
# ===================================
cdk/cdk.out/
cdk/.cdk.staging/
cdk/*.d.ts
cdk/*.js

# CloudFormation templates (can be regenerated)
*.template.json
*.template.yaml

# ===================================
# Python
# ===================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints

# ===================================
# IDE & Editor Files
# ===================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ===================================
# Node.js (for CDK CLI)
# ===================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ===================================
# Logs
# ===================================
*.log
logs/
*.out

# ===================================
# Temporary Files
# ===================================
*.tmp
*.temp
tmp/
temp/

# ===================================
# Database Files
# ===================================
*.db
*.sqlite
*.sqlite3

# ===================================
# Docker
# ===================================
.dockerignore

# ===================================
# Terraform (if used later)
# ===================================
.terraform/
*.tfstate
*.tfstate.backup

# ===================================
# OS Files
# ===================================
.DS_Store
Thumbs.db
desktop.ini

# ===================================
# IMPORTANT: Config Files Safety
# ===================================
# Allow example configs, but not actual configs with sensitive data
config/dev.yaml
config/prod.yaml
config/*.yaml
!config/*.example.yaml
!config/README.md

# ===================================
# CDK Context (may contain account info)
# ===================================
cdk.context.json
cdk/cdk.context.json

# ===================================
# Claude/AI Assistant Files
# ===================================
.claude/

# ===================================
# CDK Output at root level
# ===================================
cdk.out/

# ===================================
# Backup files
# ===================================
*.bak
*.backup
