# Sentra MVP - Git Ignore File
# IMPORTANT: Never commit credentials, account IDs, or sensitive data

# ===================================
# AWS Credentials & Configuration
# ===================================
# NEVER commit these files
*.pem
*.key
credentials
credentials.*
.aws/
aws-credentials.*
config.ini

# Environment files with secrets
.env
.env.*
!.env.example
*.local

# Cognito user credentials (NEVER commit!)
scripts/.cognito-users.conf

# ===================================
# CDK Output & Build Artifacts
# ===================================
cdk/cdk.out/
cdk/.cdk.staging/
cdk/*.d.ts
cdk/*.js

# CloudFormation templates (can be regenerated)
*.template.json
*.template.yaml

# ===================================
# Python
# ===================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints

# ===================================
# IDE & Editor Files
# ===================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ===================================
# Node.js (for CDK CLI)
# ===================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ===================================
# Logs
# ===================================
*.log
logs/
*.out

# ===================================
# Temporary Files
# ===================================
*.tmp
*.temp
tmp/
temp/

# ===================================
# Database Files
# ===================================
*.db
*.sqlite
*.sqlite3

# ===================================
# Docker
# ===================================
.dockerignore

# ===================================
# Terraform (if used later)
# ===================================
.terraform/
*.tfstate
*.tfstate.backup

# ===================================
# OS Files
# ===================================
.DS_Store
Thumbs.db
desktop.ini

# ===================================
# IMPORTANT: Config Files Safety
# ===================================
# Allow example configs, but not actual configs with sensitive data
config/dev.yaml
config/prod.yaml
config/*.yaml
!config/*.example.yaml
!config/README.md

# ===================================
# CDK Context (may contain account info)
# ===================================
cdk.context.json
cdk/cdk.context.json

# ===================================
# Claude/AI Assistant Files
# ===================================
# Ignore local Claude state, but share project skills/agents/settings in git.
# (Use .claude/* — not .claude/ — so children can be re-included below.)
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json
# Keep machine-local settings out of git
.claude/settings.local.json

# ===================================
# CDK Output at root level
# ===================================
cdk.out/

# ===================================
# Backup files
# ===================================
*.bak
*.backup

# ===================================
# Frontend build / deploy artifacts
# (app-level .gitignore covers node_modules/dist/.env; these are extras)
# ===================================
dist/
*.zip
frontend/aegionai-godaddy/

# ===================================
# Kombai design-tool working data (canvas + backups) — like .claude/, not source
# ===================================
.kombai/
Sentra.code-workspace

# harness code-loop tripwire marker (run-tests.sh)
.harness/

# harness autopilot workflow scratch (not project code)
.autopilot/

# Distilled-model training: heavy/regenerable artifacts (weights, data, bundle).
# The trained model binaries (esp. embedder_st/model.safetensors, ~449MB) exceed
# GitHub's 100MB limit and are NOT source — the training SCRIPTS + eval metrics are
# tracked, but the binaries are rebuilt into the sidecar image at build
# (docker/Dockerfile.distilled-classifier), not committed. Keep on disk, out of git.
training/distilled-classifier/venv/
training/distilled-classifier/artifacts/
training/distilled-classifier/model_bundle/
training/distilled-classifier/data/

# drift-check Lambda vendors ml_classifier_prompts/schema at package time (copies of
# the controller source); track only the handler, not the vendored copies.
lambda/distilled_drift_check/ml_classifier_prompts.py
lambda/distilled_drift_check/ml_classifier_schema.py
