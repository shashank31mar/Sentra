{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "7810311427638525264"
    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "metadata": {
        "description": "Name of the azd environment — also seeds the resource group name."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "centralus",
      "minLength": 1,
      "metadata": {
        "description": "Primary Azure region for all resources. Defaults to centralus per WS15 M3 deploy decision 2026-05-23 — see best-practices.md §11 Azure. (Was eastus2; PAYG Y1 quota propagation lag forced the move; centralus is closer-to-us-east-1 enough to stay within the LLD 15 §12 p95 ≤120ms cross-cloud budget.)"
      }
    },
    "deployerObjectId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the deployer (user or service principal). Pulled from azd: `azd env get-values | grep AZURE_PRINCIPAL_ID`. Granted Secrets Officer on Key Vault so the postProvision hook can seed the Sentra API key."
      }
    },
    "deployerPrincipalType": {
      "type": "string",
      "defaultValue": "User",
      "allowedValues": [
        "User",
        "ServicePrincipal"
      ],
      "metadata": {
        "description": "Type of the deployer principal — \"User\" for local dev (azd up from a laptop), \"ServicePrincipal\" for CI."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "Project": "AegionAI",
        "Workstream": "WS15-M3",
        "Owner": "shashank31mar@gmail.com",
        "azd_environment": "[parameters('environmentName')]"
      },
      "metadata": {
        "description": "Tags applied to every resource for cost-tracking and tear-down filtering."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
      "name": "[format('aegionai-{0}-rg', parameters('environmentName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "function-app-deployment",
      "resourceGroup": "[format('aegionai-{0}-rg', parameters('environmentName'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "environmentName": {
            "value": "[parameters('environmentName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[parameters('tags')]"
          },
          "keyVaultName": {
            "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('aegionai-{0}-rg', parameters('environmentName'))), 'Microsoft.Resources/deployments', 'key-vault-deployment'), '2025-04-01').outputs.keyVaultName.value]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "14349485026613832823"
            }
          },
          "parameters": {
            "environmentName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "metadata": {
                "description": "Name of the azd environment."
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Region — eastus2 per best-practices.md §11 Azure."
              }
            },
            "tags": {
              "type": "object",
              "metadata": {
                "description": "Tags applied to every resource."
              }
            },
            "keyVaultName": {
              "type": "string",
              "metadata": {
                "description": "Key Vault name — secret reference will be wired through app settings."
              }
            },
            "sentraApiEndpoint": {
              "type": "string",
              "defaultValue": "https://iw3limi4k7.execute-api.us-east-1.amazonaws.com/prod/v1/validate",
              "metadata": {
                "description": "AWS API Gateway URL — fixed by Workstream 16. The Function POSTs validation requests here."
              }
