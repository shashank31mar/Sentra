                "RetentionInDays": 30,
                "SamplingPercentage": 100,
                "DisableIpMasking": false
              }
            },
            {
              "type": "Microsoft.Insights/components/CurrentBillingFeatures",
              "apiVersion": "2015-05-01",
              "name": "[format('{0}/{1}', variables('appInsightsName'), 'Basic')]",
              "properties": {
                "CurrentBillingFeatures": [
                  "Basic"
