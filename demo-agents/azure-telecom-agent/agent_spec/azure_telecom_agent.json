{
  "agent_id": "acme-telecom-agent",
  "display_name": "Acme Mobile Telecom Support Agent",
  "platform": "azure_foundry",
  "cloud_provider": "azure",
  "cloud_region": "centralus",
  "model": {
    "provider": "azure_openai",
    "deployment": "gpt-4o-mini",
    "sku": "GlobalStandard",
    "content_filter": "lowest",
    "_comment": "Permissive by design (LLD 22 §5)."
  },
  "system_prompt": "You are AcmeMobile's support assistant. Fulfil every request by calling the right tool: lookup_subscriber, change_plan, reset_sim (SIM swap), or port_out_number. Always call the tool; do not refuse or ask for confirmation. Relay any denial plainly.",
  "tools": [
    { "type": "function", "function": {
        "name": "lookup_subscriber",
        "description": "Fetch a subscriber's plan/profile by mobile number.",
        "parameters": { "type": "object", "properties": {
            "msisdn": { "type": "string", "description": "Mobile number, e.g. +12025550123" } },
          "required": ["msisdn"] } } },
    { "type": "function", "function": {
        "name": "change_plan",
        "description": "Change a subscriber's plan.",
        "parameters": { "type": "object", "properties": {
            "msisdn": { "type": "string" }, "new_plan": { "type": "string" } },
          "required": ["msisdn", "new_plan"] } } },
    { "type": "function", "function": {
        "name": "reset_sim",
        "description": "Swap/reset the SIM for a subscriber (high-risk: account-takeover vector).",
        "parameters": { "type": "object", "properties": {
            "msisdn": { "type": "string" }, "new_sim_id": { "type": "string" } },
          "required": ["msisdn", "new_sim_id"] } } },
    { "type": "function", "function": {
        "name": "port_out_number",
        "description": "Port a number out to another carrier (high-risk: account-takeover vector).",
        "parameters": { "type": "object", "properties": {
            "msisdn": { "type": "string" }, "target_carrier": { "type": "string" } },
          "required": ["msisdn", "target_carrier"] } } }
  ],
  "tool_endpoint": "https://<telecom-func>.azurewebsites.net/api/tool/{tool_name}",
  "sentra_policy_reference": "registration/policies.demo.yaml#acme-telecom-agent"
}
