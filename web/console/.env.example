# Public API Gateway base (WS-16). Used by the Vite dev proxy only.
VITE_API_BASE=https://iw3limi4k7.execute-api.us-east-1.amazonaws.com/prod

# Usage-Plan API key value. Server-side only (Vite dev proxy injects it on the
# proxied hop). Copy this file to .env.local and fill in. NEVER commit the real key.
VITE_API_KEY=

# Data source: "live" (proxy to API GW) or "mock" (MSW handlers)
VITE_DATA_SOURCE=mock
