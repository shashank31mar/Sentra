# Public API Gateway base (WS-16). Used by the Vite dev proxy only.
VITE_API_BASE=https://iw3limi4k7.execute-api.us-east-1.amazonaws.com/prod

# Usage-Plan API key value. Server-side only (Vite dev proxy injects it on the
# proxied hop). Copy this file to .env.local and fill in. NEVER commit the real key.
VITE_API_KEY=

# Data source: "live" (proxy to the real /v1 API — DEFAULT) or "mock" (dev-only
# fixtures, never shipped to prod). Use "live" so the UI is API-backed; only set
# "mock" for offline UI work, and never for anything a user or reviewer will see.
VITE_DATA_SOURCE=live

# Same-origin sign-out path. Defaults to /logout (handled by the console nginx,
# which clears the ALB Cognito session and bounces to the Cognito hosted-UI
# logout). Only override for non-ALB hosting.
# VITE_LOGOUT_URL=/logout
