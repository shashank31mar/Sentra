# distilled-classifier — request-phase tier-1 front-runner model server (FR-3.12)
#
# A SEPARATE model-serving image (NOT co-located on security-controller — same
# pattern + rationale as Dockerfile.phi-ner). Hosts the distilled student
# (multilingual-MiniLM embedder → calibrated LogisticRegression head) trained by
# distilling live Haiku/Sonnet verdicts. Served warm behind CloudMap
# `distilled-classifier.sentra.internal`; the controller calls POST /classify.
#
# Build from Sentra root:
#   docker build -f docker/Dockerfile.distilled-classifier -t sentra/distilled-classifier:latest .
#
# WHY A SIDECAR (not baked into the controller): the serving stack (torch +
# sentence-transformers + the ~465MB embedder) is ~1.3GB; the controller is
# deliberately stdlib-lean (92MB). Isolate the heavy ML runtime so the PDP stays
# light and the model fleet scales independently.
#
# COLD-START OFF THE HOT PATH: the model artifact is BAKED IN at build and loaded
# EAGERLY at startup (DISTILLED_MODEL_EAGER_LOAD=1). Warm/always-on (CDK
# min_capacity>=1) so a model-load is a boot cost, never a per-request cost.

FROM python:3.11-slim

WORKDIR /app

# curl — the container health check (GET /health, matches the CDK HealthCheck).
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Web stack shared with the controller (FastAPI/uvicorn/pydantic — same pins).
COPY src/security-controller/requirements.txt ./requirements-controller.txt
RUN pip install --no-cache-dir -r requirements-controller.txt

# The serving ML stack (CPU torch — no CUDA). Pinned; own layer so the heavy model
# tooling caches independently of the app code. torch CPU wheel keeps the image off
# the ~2GB GPU builds. scikit-learn/joblib load the LogReg head; sentence-transformers
# runs the embedder.
RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    "torch==2.13.0" \
    "sentence-transformers==5.6.0" \
    "scikit-learn==1.9.0" \
    "joblib>=1.3"

# The trained model bundle (embedder_st/ + head.joblib + threshold.json), BAKED IN.
# Delivered by the training pipeline (training/distilled-classifier/model_bundle).
ENV DISTILLED_MODEL_DIR=/models/distilled
COPY training/distilled-classifier/model_bundle/ /models/distilled/

# Served app package (the distilled server IS app.distilled.server:create_served_app).
COPY src/security-controller/app/ ./app/

EXPOSE 8080

# Quiet the transformers/tokenizers noise + eager-load the model at boot (warm).
ENV TRANSFORMERS_VERBOSITY=error \
    TRANSFORMERS_NO_ADVISORY_WARNINGS=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HUB_OFFLINE=1 \
    DISTILLED_MODEL_EAGER_LOAD=1

# Least-privilege: don't run the model server as root.
RUN useradd --system --create-home --uid 10002 distilled \
    && chown -R distilled:distilled /app /models
USER distilled

# Health — liveness on the served /health route. Long start-period: the model load
# (~465MB embedder) takes some seconds at boot.
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run the SERVED distilled app (NOT the controller's app.main:app).
CMD ["uvicorn", "app.distilled.server:create_served_app", "--factory", \
     "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
