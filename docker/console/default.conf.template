# Rendered by the nginx image's envsubst at container start.
# Only ${SENTRA_*} vars are substituted (NGINX_ENVSUBST_FILTER=SENTRA_);
# nginx runtime vars like $uri are preserved.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ---- Compression ----
    # The SPA entry bundle is ~645 KB of JS + ~36 KB of CSS UNCOMPRESSED. Served
    # raw over a constrained link this dominated first-load (observed ~28 s to
    # pull index-*.js in a captured HAR). gzip cuts JS/CSS ~4x on the wire. We use
    # on-the-fly gzip (not brotli) because the stock nginx:alpine image ships the
    # gzip module but NOT the third-party brotli module. `gzip_static on` also
    # prefers a sibling precompressed `.gz` when present (harmless when absent).
    gzip on;
    gzip_static on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types
        application/javascript
        text/javascript
        text/css
        application/json
        image/svg+xml
        font/ttf
        font/otf;

    # ---- Security headers ----
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://i.pravatar.cc; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;

    # ---- API proxy: inject x-api-key server-side (never in the browser) ----
    location /v1/ {
        # Runtime DNS re-resolution. ${SENTRA_API_BASE} is the INTERNAL ALB, whose
        # IPs can rotate (scaling events). A literal proxy_pass resolves the host
        # ONCE at worker start and would pin a now-stale IP until the next deploy.
        # Putting the upstream in a VARIABLE forces nginx to resolve per request via
        # the resolver below; valid=10s bounds how long a changed record is cached.
        # 169.254.169.253 is the Amazon-provided VPC DNS (reachable from any VPC);
        # ipv6=off avoids pointless AAAA lookups for the IPv4-only ALB. Because the
        # upstream is a variable, nginx no longer rewrites the path automatically, so
        # we forward the original $request_uri (path + query) explicitly.
        resolver 169.254.169.253 valid=10s ipv6=off;
        set $sentra_api "${SENTRA_API_BASE}";
        proxy_pass $sentra_api$request_uri;
        proxy_set_header x-api-key "${SENTRA_API_KEY}";
        proxy_set_header Host "${SENTRA_API_HOST}";
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        # Carry the operator's ALB-Cognito identity to the controller under a
        # NON-RESERVED name. The public ALB injects `x-amzn-oidc-data`, but every
        # downstream gateway hop (API Gateway AND the internal ALB) strips inbound
        # `x-amzn-oidc-*` (anti-spoofing) — so it never reaches the controller.
        # Re-emit it as `x-sentra-oidc-data`, which the gateway forwards untouched;
        # the controller's verify_alb_oidc reads it and still verifies the ALB
        # signature. Without this, every auth'd control-plane route 401s.
        proxy_set_header X-Sentra-Oidc-Data $http_x_amzn_oidc_data;
    }

    # ---- Static assets: long cache for hashed files ----
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---- Identity echo: surface the ALB-injected Cognito claim to the SPA ----
    # The public ALB authenticates via Cognito and injects x-amzn-oidc-* headers
    # on the upstream hop. The browser can't read them, so expose a tiny
    # same-origin JSON endpoint the console can fetch (/whoami). `name`/`groups`
    # need the signed x-amzn-oidc-data JWT decoded (njs/lua) — left null here, the
    # SPA prettifies the email local-part as a display-name fallback.
    location = /whoami {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"email":"$http_x_amzn_oidc_identity","name":null,"username":"$http_x_amzn_oidc_identity","groups":[]}';
    }

    # ---- Sign-out: clear the ALB Cognito session, bounce to Cognito logout ----
    # No REST logout API exists; the SPA performs a top-level navigation here.
    # SENTRA_COGNITO_LOGOUT_URL is the Cognito hosted-UI logout endpoint, e.g.
    # https://<domain>.auth.<region>.amazoncognito.com/logout?client_id=<id>&logout_uri=https://<alb>/
    location = /logout {
        add_header Set-Cookie "AWSELBAuthSessionCookie-0=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT" always;
        add_header Set-Cookie "AWSELBAuthSessionCookie-1=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT" always;
        return 302 "${SENTRA_COGNITO_LOGOUT_URL}";
    }

    # ---- SPA history fallback ----
    # index.html must NOT be heuristically cached: it points at the hashed /assets/ bundle, so a
    # stale index.html silently pins the browser to an old build (new deploys appear "invisible"
    # until a hard refresh). `no-cache` = the browser may store it but MUST revalidate every load
    # (ETag → fast 304 when unchanged, fresh 200 right after a deploy). The hashed assets above stay
    # immutable/long-cached, so this costs one tiny conditional request per navigation.
    # ---- Public splash (LLD-26 WS-C): the designed Aegion front door ----
    # Served at EXACT `/` only, no SPA dependency. The public ALB exempts `/` +
    # `/splash.html` from authenticate-cognito (higher-priority listener rule), so
    # this renders without a session. Its "Access Control Plane" button links to
    # /overview, which IS behind Cognito → the operator signs in and lands in the
    # authenticated console. Every other path stays SPA + Cognito-gated.
    location = / {
        try_files /splash.html =404;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
